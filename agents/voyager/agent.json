{
  "schema": "cbap-agent/1",
  "id": "voyager",
  "display_name": "Voyager Bridge",
  "status": "active",
  "ownership": "external",
  "kind": "bridge-only",
  "summary": "Voyager Mineflayer HTTP bridge exposed through a line-JSON adapter. Voyager's autonomous agent is not wired.",
  "runtime": {
    "upstream": "external/Voyager",
    "adapter": "agents/voyager/adapter/adapter.mjs",
    "driver": "agents/voyager/adapter",
    "state_patch": "agents/voyager/adapter/patches/voyager-state.patch"
  },
  "cbap": {
    "driver_module": "drivers.mc.driver",
    "driver_factory": "McDriver",
    "device_id": "mc://voyager/bot",
    "transport": "HTTP bridge -> line-json",
    "control_surface": "state / exec / forward / say / stop"
  }
}
