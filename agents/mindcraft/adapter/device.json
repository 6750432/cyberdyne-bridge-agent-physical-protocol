{
  "device_id": "mc://mind/Mindy",
  "type": "minecraft-mindcraft-agent",
  "cbap": "1.0",
  "display_name": "Mindcraft autonomous agent (headless adapter)",
  "channels": {
    "body": {
      "direction": "rw",
      "read": ["pose", "hp", "food", "on_ground", "held", "acting"],
      "write": ["stop"]
    },
    "inventory": {
      "direction": "r",
      "read": ["items"]
    },
    "chat": {
      "direction": "rw",
      "read": ["chat"],
      "write": ["prompt"]
    }
  },
  "capabilities": ["chat", "autonomy", "stop", "inventory"],
  "limits": {
    "max_frame": 65536,
    "max_inflight": 1,
    "rate_hz": 1,
    "max_command_ms": 30000
  },
  "safety": {
    "estop": "stop-agent",
    "watchdog_ms": 5000,
    "safe_state": "agent-stopped"
  },
  "schemas": {
    "body.state": "schema://mc/body-state/1"
  },
  "metadata": {
    "transport": "unix",
    "backend": "mindcraft + mindserver socket.io",
    "driver": "drivers/mindcraft/adapter.mjs",
    "note": "read is full-state; prompt asks the autonomous agent; stop stops the agent process. No direct low-level action injection."
  }
}
