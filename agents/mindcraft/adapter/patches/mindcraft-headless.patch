-        mineflayerViewer(bot, { port: 3000+count_id, firstPerson: true, });
+    if (!settings.render_bot_view) return;
+    // Headless installs often do not have canvas/gl native modules.
+    // Lazy-load the viewer only when rendering is explicitly enabled.
+    import('prismarine-viewer').then(({ default: pv }) => {
+        pv.mineflayer(bot, { port: 3000+count_id, firstPerson: true });
+    }).catch((err) => {
+        console.warn('Browser viewer disabled:', err.message);
+    });
 }
