{
  "schema": "cbap-agent/1",
  "id": "mcp-mineflayer",
  "display_name": "MCP Mineflayer Body",
  "status": "active",
  "ownership": "external",
  "kind": "mcp-body",
  "summary": "Real external Mineflayer MCP server wrapped by MCPDriver.",
  "runtime": {
    "upstream": "external/mineflayer-mcp",
    "driver": "agents/mcp-mineflayer/driver",
    "patch": "agents/mcp-mineflayer/driver/patches/mineflayer-mcp-place.patch",
    "tools": [
      "agents/mcp-mineflayer/tools/"
    ],
    "smoke": "agents/mcp-mineflayer/smoke.py"
  },
  "cbap": {
    "driver_module": "agents.mcp-mineflayer.driver.driver",
    "driver_factory": "MCPDriver",
    "device_id": "mcp://mc/MCPBody",
    "transport": "mcp-stdio"
  }
}
